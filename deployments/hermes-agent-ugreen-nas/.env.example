# Required by Compose. Capture the digest with docker image inspect.
HERMES_IMAGE=nousresearch/hermes-agent@sha256:replace-with-tested-digest
NAS_LAN_IP=192.168.1.10
HERMES_UID=10000
HERMES_GID=10000

# Hermes gateway configuration
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
API_SERVER_KEY=replace-with-output-of-openssl-rand-hex-32
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_ALLOWED_USERS=replace-with-numeric-telegram-user-id
